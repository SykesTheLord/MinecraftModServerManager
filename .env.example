# Copied to .env and read by docker-compose / the manager server on first boot.

# Seeded on first run only — change the password after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-immediately

# Long random string used to sign session cookies. Generate with e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Base domain used to suggest full subdomains in the UI (e.g. pack1.mc.example.com).
# Wildcard DNS (*.mc.example.com -> this host) must already point here; this app
# does not manage DNS.
BASE_DOMAIN=mc.example.com

# Port the manager's web UI/API listens on (not the Minecraft port).
MANAGER_PORT=8080

# Host interface the manager's port is published on. Defaults to localhost
# only: the manager speaks plain HTTP (passwords and session cookies in
# cleartext) and controls Docker, so reach it through an SSH tunnel, a VPN,
# or a TLS reverse proxy on this host. Set to 0.0.0.0 to expose it on every
# interface — note that then modpack containers can also reach it via the
# host's address, just like any LAN device.
MANAGER_BIND=127.0.0.1

# CurseForge API key, needed to browse and deploy CurseForge modpacks (FTB
# packs and imports work without it). Free from https://console.curseforge.com/
# — use your own; it's tied to your account and its terms. Only the manager
# and its short-lived install containers ever see it, never a modpack server.
CF_API_KEY=

# How often FTB/CurseForge servers are checked for a newer version of their
# modpack, in hours (0 = never). Each server chooses on its Updates tab
# whether to just show updates or install them automatically when empty.
PACK_UPDATE_CHECK_HOURS=6

# Largest server that can be imported (Import Server page), in bytes of
# extracted files. Imports are staged in the manager's data volume before
# being copied into their own, so this much free space is needed temporarily.
# Default 64 GiB.
IMPORT_MAX_BYTES=68719476736

# Only if a reverse proxy (e.g. for TLS) sits in front of the manager: which
# proxy to trust for X-Forwarded-For/-Proto/-Host — "true" (any), a hop count
# like "1", or its address. Leave empty otherwise; trusting these headers from
# arbitrary clients lets them spoof their IP past login rate limiting.
TRUST_PROXY=
