# =============================================================================

# Emacs
\#*\#
.\#*
*.elc
auto-save-list/
.projectile
.dir-locals-2.el
# Sublime Text (a shared *.sublime-project stays committable)
*.sublime-workspace
# Zed — local tasks/debug state (shared .zed/settings.json stays committable)
.zed/debug.json

# =============================================================================
# Shell / environment tooling
# =============================================================================

# direnv — the cache dir and personal overrides (a shared .envrc stays committable)
.direnv/
.envrc.local

# Leftovers from merges, patches and quick edits
*.orig
*.rej
*.bak
*.tmp
*.temp

