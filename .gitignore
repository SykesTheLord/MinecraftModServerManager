# =============================================================================
# Project
# =============================================================================

node_modules/
dist/
build/
coverage/
*.tsbuildinfo
*.log
npm-debug.log*
.npm/

# Secrets / runtime state
.env
.env.*
!.env.example
data/
server/data/
server/public/
*.sqlite
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Host-browsable logs (docker-compose bind mount) — keep only the placeholder
logs/*
!logs/.gitkeep

# Infrared's config loader treats every file in this directory as a proxy
# config and errors on anything else (even a .gitkeep) — never put a
# placeholder file in here. Docker Compose auto-creates the empty directory.
infrared/configs/

# Database backups made by scripts/update.sh
backups/

# Private keys someone dropped in for SSH imports (see SSH_KEYS_DIR in .env.example)
ssh-keys/*
!ssh-keys/.gitkeep

# Per-machine Docker Compose overrides (e.g. a different port bind, extra
# mounts while debugging) — the shared definition is docker-compose.yml.
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# TLS material, e.g. for a reverse proxy in front of the manager (see TRUST_PROXY)
*.pem
*.key
*.crt
*.p12
*.pfx
certs/

# =============================================================================
# Node / package managers / build tooling
# =============================================================================

# Other package managers' state (this repo uses npm + package-lock.json)
.pnpm-store/
.yarn/*
!.yarn/releases/
.pnp.*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tgz

# Tool caches
.cache/
.vite/
vite.config.*.timestamp-*
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
.node_repl_history

# Testing (no suite yet — planned in docs/TODO.md)
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
*.lcov
junit.xml

# Runtime diagnostics
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
*.heapsnapshot
*.cpuprofile
pids/
*.pid
*.pid.lock
*.seed

# =============================================================================
# Agentic coding tools
# Rule of thumb: ignore each tool's personal/local state and caches, but keep
# shared, team-wide instructions committable (CLAUDE.md, AGENTS.md, GEMINI.md,
# .cursor/rules/, .clinerules, .windsurfrules, .roo/, .github/copilot-instructions.md, ...).
# =============================================================================

# Claude Code — commit .claude/settings.json, commands/, agents/, skills/; ignore personal state
.claude/settings.local.json
.claude/*.lock
.claude/todos/
.claude/worktrees/
CLAUDE.local.md

# Cursor — commit .cursor/rules/ and .cursorignore; the rest (incl. mcp.json, which may hold tokens) is local
.cursor/*
!.cursor/rules/

# Aider — chat/input history and repo-map caches (a shared .aider.conf.yml stays committable)
.aider.chat.history.md
.aider.input.history
.aider.llm.history
.aider.tags.cache.v*/

# Continue — commit rules/prompts; config can contain API keys
.continue/*
!.continue/rules/
!.continue/prompts/

# Gemini CLI — project-level secrets and scratch
.gemini/.env
.gemini/tmp/

# OpenAI Codex CLI — local session state
.codex/sessions/
.codex/log/

# Windsurf / Codeium — local caches
.codeium/
.windsurf/cache/

# Cline / Roo Code — task history and checkpoints (rules in .clinerules / .roo/ stay committable)
.cline/
.roo/tasks/
.roo/checkpoints/

# Kiro — local MCP settings (specs/steering stay committable)
.kiro/settings/mcp.json

# OpenHands — local runtime state
.openhands-state/

# Generic AI scratch/cache dirs
.ai-cache/
.llm-cache/

# =============================================================================
# JetBrains IDEs (IntelliJ IDEA, WebStorm, PyCharm, GoLand, Rider, Fleet, ...)
# =============================================================================

.idea/
*.iml
*.ipr
*.iws
out/
.fleet/
cmake-build-*/
# HTTP Client private environment (holds credentials)
http-client.private.env.json

# =============================================================================
# VS Code and its forks (Cursor, Windsurf, ...) — keep shareable recommendations
# =============================================================================

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.history/

