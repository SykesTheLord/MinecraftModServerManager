[._]*.s[a-v][a-z]
!*.svg
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
# Sessions, undo, netrw, logs, tags
Session.vim
Sessionx.vim
*.un~
.netrwhist
.nvimlog
tags
tags.lock
tags.temp

