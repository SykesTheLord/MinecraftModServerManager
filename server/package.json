{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "express-session": "^1.18.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rcon-client": "^4.2.5",
    "ssh2": "^1.17.0",
    "tar-fs": "^3.1.3",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.19.0",
    "@types/ssh2": "^1.15.6",
    "@types/tar-fs": "^2.0.4",
    "@types/ws": "^8.5.12",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2"
  }
}
